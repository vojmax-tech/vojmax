---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/sections/Footer.astro";
import { CONTACT } from "../data/site";
---

<BaseLayout title="Contact | vojmax" description="Get in touch to discuss projects, engineering, and design.">
  <Navbar alwaysVisible={true} homeSectionLinks={true} />

  <main class="contact-page container-fluid pt-28 md:pt-36 pb-24">
    <div class="contact-grid">
      
      <!-- Left side: Manifesto / Direct Links -->
      <section class="contact-info">
        <h1 class="contact-title font-display">Let's build something.</h1>
        <p class="contact-lede">
          Whether it's a brand and the site it lives on, or a system to sit
          behind it, I'm ready to help. Reach out directly or fill out the form.
        </p>
        
        <div class="direct-links">
          <a href={CONTACT.whatsapp} target="_blank" rel="noopener" class="contact-btn whatsapp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            Chat on WhatsApp
          </a>

          <a href={`tel:${CONTACT.phone}`} class="contact-btn phone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Give me a call
          </a>
          
          <a href={`mailto:${CONTACT.email}`} class="contact-btn email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            vicmaxjames56@gmail.com
          </a>
        </div>
      </section>

      <!-- Right side: Inquiry Form -->
      <section class="contact-form-wrapper">
        <form
          class="inquiry-form"
          id="inquiry-form"
          data-whatsapp={CONTACT.whatsapp}
          data-email={CONTACT.email}
        >
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Jane Doe" />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com" />
          </div>

          <div class="form-group split">
            <div class="sub-group">
              <label for="timeline">Timeline</label>
              <select id="timeline" name="timeline">
                <option value="ASAP">As soon as possible</option>
                <option value="1-3 months">1-3 months</option>
                <option value="3-6 months">3-6 months</option>
                <option value="6+ months">6+ months</option>
              </select>
            </div>
            <div class="sub-group">
              <label for="budget">Budget</label>
              <select id="budget" name="budget">
                <option value="< $5k">Under $5k</option>
                <option value="$5k - $10k">$5k - $10k</option>
                <option value="$10k - $25k">$10k - $25k</option>
                <option value="$25k+">$25k+</option>
              </select>
            </div>
          </div>
          
          <div class="form-group">
            <label for="details">Project Details</label>
            <textarea id="details" name="details" rows="5" required placeholder="Tell me about what you're building..."></textarea>
          </div>
          
          <button type="submit" class="submit-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            Send on WhatsApp
          </button>

          <button type="button" class="alt-submit" id="send-as-email">
            Send as email instead
          </button>

          <p class="form-note">
            Your answers get written up as one message. You read it and press
            send, so nothing leaves your phone without you.
          </p>

          <noscript>
            <p class="form-note">
              This form needs JavaScript. Use the WhatsApp or email links on the
              left instead.
            </p>
          </noscript>
        </form>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: start;
    max-width: 68rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .contact-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.08;
    color: rgb(var(--text));
  }

  .contact-lede {
    margin: 0 0 2.5rem;
    font-weight: 300;
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgb(var(--text) / 0.75);
  }

  .direct-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.15);
    font-size: 0.95rem;
    font-weight: 500;
    color: rgb(var(--text));
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .contact-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -10px rgb(0 0 0 / 0.2);
  }

  .contact-btn.whatsapp:hover {
    border-color: #25D366;
    color: #25D366;
  }

  .contact-btn.phone:hover {
    border-color: rgb(var(--accent));
    color: rgb(var(--accent));
  }

  .contact-btn.email:hover {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  /* Form Styles */
  .contact-form-wrapper {
    padding: 2.5rem;
    border-radius: var(--radius-xl);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.1);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.15);
    backdrop-filter: blur(12px);
  }

  .form-group {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group.split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .sub-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgb(var(--text) / 0.8);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: rgb(var(--bg));
    border: 1px solid rgb(var(--border) / 0.2);
    color: rgb(var(--text));
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: rgb(var(--accent));
    box-shadow: 0 0 0 3px rgb(var(--accent) / 0.15);
  }

  input::placeholder,
  textarea::placeholder {
    color: rgb(var(--text) / 0.3);
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    margin-top: 0.5rem;
    border-radius: var(--radius-md);
    background: rgb(var(--text));
    color: rgb(var(--bg));
    border: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    background: rgb(var(--accent));
    color: white;
  }
  
  :global([data-theme="light"]) .submit-btn {
    background: rgb(var(--accent));
    color: white;
  }
  
  :global([data-theme="light"]) .submit-btn:hover {
    filter: brightness(1.1);
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .alt-submit {
    width: 100%;
    margin-top: 0.75rem;
    padding: 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid rgb(var(--border) / 0.2);
    background: transparent;
    color: rgb(var(--text) / 0.75);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .alt-submit:hover {
    border-color: rgb(var(--accent) / 0.5);
    color: rgb(var(--accent));
  }

  .form-note {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgb(var(--text) / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .alt-submit {
      transition: none;
    }
    .contact-btn, .submit-btn {
      transition: none;
    }
    .contact-btn:hover, .submit-btn:hover {
      transform: none;
    }
  }
</style>

<script>
  /**
   * The form has no backend. It formats the answers into one message and hands
   * them to WhatsApp (or the visitor's mail client), where they press send.
   * Nothing to host, no keys, no third party holding the leads.
   */
  const form = document.getElementById("inquiry-form") as HTMLFormElement | null;

  if (form) {
    const compose = () => {
      const data = new FormData(form);
      const get = (key: string) => String(data.get(key) ?? "").trim();

      const lines = [
        "New project inquiry from vojmax.dev",
        "",
        `Name: ${get("name")}`,
        `Email: ${get("email")}`,
        `Timeline: ${get("timeline")}`,
        `Budget: ${get("budget")}`,
        "",
        "Project details:",
        get("details"),
      ];

      return { body: lines.join("\n"), name: get("name") };
    };

    /** Native validation still gates both paths. */
    const validate = () => form.reportValidity();

    const open = (url: string) => {
      const win = window.open(url, "_blank", "noopener");
      if (!win) window.location.href = url;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const { body } = compose();
      const base = form.dataset.whatsapp ?? "";
      open(`${base}?text=${encodeURIComponent(body)}`);
    });

    document.getElementById("send-as-email")?.addEventListener("click", () => {
      if (!validate()) return;
      const { body, name } = compose();
      const subject = `Project inquiry from ${name || "vojmax.dev"}`;
      const address = form.dataset.email ?? "";
      window.location.href = `mailto:${address}?subject=${encodeURIComponent(
        subject,
      )}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
