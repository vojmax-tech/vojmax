---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import ProjectCover from "../../components/ui/ProjectCover.astro";
import { projects, disciplineLabels, statusLabels } from "../../data/projects";
import fs from "node:fs";
import path from "node:path";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const coverPath = path.join(process.cwd(), "public", "projects", `${project.slug}-main.png`);
const hasCover = fs.existsSync(coverPath);
const src = hasCover ? `/projects/${project.slug}-main.png` : undefined;

// Next project in the list, so a case study never dead-ends.
const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];
---

<BaseLayout title={`${project.title} | vojmax`} description={project.tagline}>
  <Navbar alwaysVisible={true} homeSectionLinks={true} />

  <main class="case-study pt-24 md:pt-28 pb-20">
    <div class="container-fluid">
      <a href="/work" class="back-link group">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        All work
      </a>

      <!-- Header -->
      <header class="cs-head">
        <div class="cs-meta font-mono">
          <span class={`status status-${project.status}`}>
            {statusLabels[project.status]}
          </span>
          <span>{project.category}</span>
          <span>{project.year}</span>
        </div>

        <h1 class="cs-title font-display">{project.title}</h1>
        <p class="cs-tagline">{project.tagline}</p>

        <div class="cs-links">
          {
            project.repo && (
              <a href={project.repo} target="_blank" rel="noopener" class="cs-link primary">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
                Source
              </a>
            )
          }
          {
            project.demo && (
              <a href={project.demo} target="_blank" rel="noopener" class="cs-link">
                Live site
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M15 3h6v6M10 14L21 3" />
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              </a>
            )
          }
          {
            !project.repo && !project.demo && (
              <p class="cs-nolink">Not public yet. Happy to walk through it.</p>
            )
          }
        </div>
      </header>

      <!-- Cover -->
      <div class="cs-cover">
        <ProjectCover
          title={project.title}
          slug={project.slug}
          hue={project.hue}
          size="hero"
          src={src}
        />
      </div>

      <!-- Body -->
      <div class="cs-body">
        <article class="cs-prose">
          <section>
            <h2 class="cs-h2">Overview</h2>
            {project.overview.map((para) => <p>{para}</p>)}
          </section>

          <section>
            <h2 class="cs-h2">What it does</h2>
            <ul class="cs-list">
              {project.highlights.map((item) => (
                <li>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>

          {
            project.architecture && (
              <section>
                <h2 class="cs-h2">How it's put together</h2>
                <p>{project.architecture}</p>
              </section>
            )
          }

          {
            project.notes && (
              <section>
                <h2 class="cs-h2">Limits &amp; open questions</h2>
                <p class="cs-note">{project.notes}</p>
              </section>
            )
          }
        </article>

        <!-- Sidebar -->
        <aside class="cs-aside">
          <div class="aside-block">
            <h3 class="aside-label">My role</h3>
            <p class="aside-text">{project.role}</p>
          </div>

          <div class="aside-block">
            <h3 class="aside-label">Stack</h3>
            <ul class="aside-tags">
              {project.stack.map((tech) => <li>{tech}</li>)}
            </ul>
          </div>

          <div class="aside-block">
            <h3 class="aside-label">Discipline</h3>
            <ul class="aside-tags">
              {
                project.disciplines.map((d) => (
                  <li>
                    <a href={`/work?filter=${d}`}>{disciplineLabels[d]}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>

      <!-- Next -->
      <a href={`/work/${next.slug}`} class="next-project group">
        <span class="next-label font-mono">Next project</span>
        <span class="next-title font-display">{next.title}</span>
        <span class="next-tagline">{next.tagline}</span>
        <span class="next-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: rgb(var(--muted));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: rgb(var(--accent));
  }

  .back-link svg {
    transition: transform 0.2s ease;
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  /* Header */
  .cs-head {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--muted));
  }

  .status {
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid currentColor;
  }

  .status-shipped {
    color: rgb(74 222 128);
  }
  .status-active {
    color: rgb(var(--accent));
  }
  .status-building {
    color: rgb(var(--muted));
  }

  .cs-title {
    margin: 0 0 0.9rem;
    font-size: var(--step-4);
    line-height: 1.06;
    color: rgb(var(--text));
  }

  .cs-tagline {
    margin: 0 0 1.75rem;
    max-width: 54ch;
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--text) / 0.75);
  }

  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cs-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-full);
    border: 1px solid rgb(var(--border) / 0.18);
    background: rgb(var(--panel));
    color: rgb(var(--text));
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .cs-link:hover {
    border-color: rgb(var(--accent) / 0.5);
    color: rgb(var(--accent));
  }

  .cs-link.primary {
    background: rgb(var(--accent));
    border-color: rgb(var(--accent));
    color: rgb(var(--bg));
  }

  :global(html[data-theme="light"]) .cs-link.primary {
    color: #fff;
  }

  .cs-link.primary:hover {
    color: rgb(var(--bg));
    filter: brightness(1.1);
  }

  :global(html[data-theme="light"]) .cs-link.primary:hover {
    color: #fff;
  }

  .cs-nolink {
    margin: 0;
    font-size: 0.88rem;
    color: rgb(var(--muted));
    font-style: italic;
  }

  /* Cover */
  .cs-cover {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid rgb(var(--border) / 0.1);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 640px) {
    .cs-cover {
      aspect-ratio: 16 / 10;
    }
  }

  /* Body */
  .cs-body {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .cs-body {
      grid-template-columns: 1fr;
    }
  }

  .cs-prose section {
    margin-bottom: 2.75rem;
  }

  .cs-h2 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: rgb(var(--text));
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(var(--border) / 0.1);
  }

  .cs-prose p {
    margin: 0 0 1.1rem;
    max-width: 68ch;
    font-size: var(--step-0);
    font-weight: 300;
    line-height: 1.78;
    color: rgb(var(--text) / 0.82);
  }

  .cs-note {
    padding: 1rem 1.25rem;
    border-left: 2px solid rgb(var(--accent) / 0.5);
    background: rgb(var(--panel) / 0.6);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .cs-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 68ch;
  }

  .cs-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--text) / 0.82);
  }

  .cs-list svg {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: rgb(var(--accent));
  }

  /* Sidebar */
  .cs-aside {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: 6rem;
  }

  @media (max-width: 900px) {
    .cs-aside {
      position: static;
    }
  }

  .aside-block {
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.1);
  }

  .aside-label {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--accent));
  }

  .aside-text {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--text) / 0.8);
  }

  .aside-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aside-tags li {
    padding: 0.28rem 0.6rem;
    border-radius: var(--radius-sm);
    background: rgb(var(--panel2));
    border: 1px solid rgb(var(--border) / 0.08);
    font-size: 0.75rem;
    color: rgb(var(--text) / 0.75);
  }

  .aside-tags a {
    color: inherit;
    text-decoration: none;
  }

  .aside-tags a:hover {
    color: rgb(var(--accent));
  }

  /* Next */
  .next-project {
    position: relative;
    display: block;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: var(--radius-xl);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.1);
    text-decoration: none;
    transition: border-color 0.25s ease;
  }

  .next-project:hover {
    border-color: rgb(var(--accent) / 0.45);
  }

  .next-label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--accent));
  }

  .next-title {
    display: block;
    font-size: var(--step-2);
    font-weight: 700;
    color: rgb(var(--text));
    margin-bottom: 0.4rem;
  }

  .next-tagline {
    display: block;
    max-width: 52ch;
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(var(--text) / 0.68);
  }

  .next-arrow {
    position: absolute;
    top: 50%;
    right: clamp(1.75rem, 4vw, 2.5rem);
    transform: translateY(-50%);
    font-size: 1.5rem;
    color: rgb(var(--accent));
    transition: transform 0.25s ease;
  }

  .next-project:hover .next-arrow {
    transform: translateY(-50%) translateX(6px);
  }

  @media (max-width: 640px) {
    .next-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-arrow,
    .back-link svg {
      transition: none;
    }
    .next-project:hover .next-arrow {
      transform: translateY(-50%);
    }
    .back-link:hover svg {
      transform: none;
    }
  }
</style>
