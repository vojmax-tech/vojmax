---
import { CONTACT } from "../../data/site";
---

<section class="contact-section">
  <div class="container-fluid">
    <div class="contact-inner">
      <h2 class="contact-title font-display">
        Have a project in mind?<br />Let's build it.
      </h2>
      <p class="contact-lede">
        Available for engineering and design roles, or consulting on system
        architecture and product builds.
      </p>

      <div class="contact-actions">
        <a href="/contact" class="contact-primary">
          Get in touch
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid rgb(var(--border) / 0.1);
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .contact-inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .contact-title {
    margin: 0 0 1rem;
    font-size: var(--step-3);
    line-height: 1.12;
    color: rgb(var(--text));
  }

  .contact-lede {
    margin: 0 auto 2rem;
    max-width: 46ch;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--text) / 0.72);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .contact-primary,
  .contact-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.8rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .contact-primary {
    background: rgb(var(--accent));
    color: rgb(var(--bg));
  }

  :global(html[data-theme="light"]) .contact-primary {
    color: #fff;
  }

  .contact-primary:hover {
    transform: translateY(-2px);
  }

  .contact-secondary {
    border: 1px solid rgb(var(--border) / 0.2);
    background: rgb(var(--panel));
    color: rgb(var(--text));
  }

  .contact-secondary:hover {
    border-color: rgb(var(--accent) / 0.5);
    color: rgb(var(--accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-primary:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .contact-primary,
    .contact-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
