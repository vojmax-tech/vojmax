---
/** How I work. Three claims the projects on this site should back up. */
interface Principle {
  title: string;
  body: string;
  icon: string;
}

const principles: Principle[] = [
  {
    title: "Design and code are one job",
    body: "The worst problems show up in the handoff. When the person choosing the type scale is also writing the component, that gap closes and the work ships whole.",
    icon: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>`,
  },
  {
    title: "Say what it can't do",
    body: "Every model has an error bar and every dataset has a blind spot. Naming them up front is what makes the rest of the work worth trusting.",
    icon: `<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>`,
  },
  {
    title: "Build the offline path first",
    body: "Networks drop, APIs time out, phones lose signal. Software that only holds up under ideal conditions still has work left in it.",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
];
---

<section class="values-section">
  <div class="values-head">
    <h3 class="values-title font-display">How I work</h3>
    <p class="values-note">What the projects above should show in practice.</p>
  </div>

  <div class="values-grid">
    {
      principles.map((p) => (
        <article class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={p.icon}
            />
          </div>
          <h4 class="value-title">{p.title}</h4>
          <p class="value-body">{p.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .values-section {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgb(var(--border) / 0.08);
  }

  .values-head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .values-title {
    margin: 0 0 0.35rem;
    font-size: var(--step-2);
    color: rgb(var(--text));
  }

  .values-note {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 300;
    color: rgb(var(--muted));
  }

  .values-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .value-card {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.1);
    transition: border-color 0.25s ease;
  }

  .value-card:hover {
    border-color: rgb(var(--accent) / 0.3);
  }

  .value-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-full);
    background: rgb(var(--accent) / 0.12);
    color: rgb(var(--accent));
  }

  .value-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: rgb(var(--text));
  }

  .value-body {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(var(--text) / 0.72);
  }
</style>
