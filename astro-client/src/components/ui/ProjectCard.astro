---
import ProjectCover from "./ProjectCover.astro";
import type { Project } from "../../data/projects";
import { statusLabels } from "../../data/projects";
import fs from "node:fs";
import path from "node:path";

type Props = Project;

const { slug, title, tagline, category, stack, status, year, hue } = Astro.props;

const coverPath = path.join(process.cwd(), "public", "projects", `${slug}-main.png`);
const hasCover = fs.existsSync(coverPath);
const src = hasCover ? `/projects/${slug}-main.png` : undefined;
---

<a
  href={`/work/${slug}`}
  class="project-card group"
  data-status={status}
  aria-label={`${title}, case study`}
>
  <div class="card-cover">
    <ProjectCover title={title} slug={slug} hue={hue} src={src} />
    <span class={`status-pill status-${status}`}>
      <span class="status-dot" aria-hidden="true"></span>
      {statusLabels[status]}
    </span>
  </div>

  <div class="card-body">
    <p class="card-meta font-mono">
      <span>{category}</span>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
    </p>

    <h3 class="card-title font-display">{title}</h3>
    <p class="card-tagline">{tagline}</p>

    <ul class="card-stack" aria-label="Stack">
      {stack.slice(0, 4).map((tech) => <li>{tech}</li>)}
      {stack.length > 4 && <li class="more">+{stack.length - 4}</li>}
    </ul>
  </div>
</a>

<style>
  .project-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: rgb(var(--panel));
    border: 1px solid rgb(var(--border) / 0.1);
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    border-color: rgb(var(--accent) / 0.45);
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.18);
  }

  .project-card:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 3px;
  }

  .card-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid rgb(var(--border) / 0.08);
  }

  .status-pill {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background: rgb(var(--bg) / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgb(var(--border) / 0.14);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text) / 0.8);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-active .status-dot {
    background: rgb(var(--accent));
    animation: pulse 2.4s ease-in-out infinite;
  }

  .status-shipped .status-dot {
    background: rgb(74 222 128);
  }

  .status-building .status-dot {
    background: rgb(var(--muted));
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-active .status-dot {
      animation: none;
    }
    .project-card:hover {
      transform: none;
    }
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem 1.25rem 1.4rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--accent));
  }

  .card-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: rgb(var(--text));
    transition: color 0.2s ease;
  }

  .project-card:hover .card-title {
    color: rgb(var(--accent));
  }

  .card-tagline {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.55;
    color: rgb(var(--text) / 0.72);
    flex: 1;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card-stack li {
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgb(var(--panel2));
    border: 1px solid rgb(var(--border) / 0.08);
    font-size: 0.7rem;
    color: rgb(var(--text) / 0.66);
  }

  .card-stack .more {
    color: rgb(var(--muted));
  }
</style>
