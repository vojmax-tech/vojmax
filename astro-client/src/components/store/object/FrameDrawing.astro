<style>
  .fd {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }

  .fd svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fd-t {
    font-family: var(--font-tech, ui-monospace, monospace);
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  /* Structural lines: only traced during the draw-in on the render (they would
     cross over shapes that overlap), the whole drawing in outline mode. */
  .fd-lines path {
    stroke: rgb(var(--text) / 0);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .fd--outline .fd-lines path,
  .fd-sketch {
    stroke: rgb(var(--muted) / 0.62);
    stroke-width: 1.1;
  }

  .fd-sketch * {
    vector-effect: non-scaling-stroke;
  }

  .fd-sketch {
    stroke: rgb(var(--muted) / 0.38);
  }

  .fd-sketch .fd-sketch-sel {
    stroke: rgb(var(--accent) / 0.8);
  }

  /* Annotation layer */
  .fd-notes * {
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }

  .fd-guide {
    stroke: rgb(var(--border) / 0.3);
  }

  .fd-dim,
  .fd-leader {
    stroke: rgb(var(--muted) / 0.6);
  }

  .fd-tick {
    stroke: rgb(var(--accent));
  }

  .fd-node {
    fill: rgb(var(--accent));
    stroke: none;
  }

  .fd-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fd-label {
    position: absolute;
    font-size: max(0.6rem, 1.05cqi);
    white-space: nowrap;
    color: rgb(var(--muted));
  }

  .fd-label--accent {
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    background: rgb(var(--accent));
    color: rgb(var(--bg));
    letter-spacing: 0.1em;
  }

  /* Too small to carry annotations: keep the object, drop the words and the
     lines that only lead to them. */
  @container (max-width: 480px) {
    .fd-notes,
    .fd-labels {
      display: none;
    }
  }

  /* Draw-in: the lines trace once, then the object settles in and the lines
     fade back to faint edges. Triggered by the global reveal observer. */
  .fd--draw .fd-lines path {
    stroke: rgb(var(--text) / 0.55);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .fd--draw .fd-object,
  .fd--draw .fd-notes,
  .fd--draw .fd-labels {
    opacity: 0;
  }

  :global(.reveal-visible) .fd--draw .fd-lines path {
    stroke: rgb(var(--text) / 0);
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.15s,
      stroke 1.2s ease 1.6s;
  }

  :global(.reveal-visible) .fd--draw .fd-object {
    opacity: 1;
    transition: opacity 1.2s ease 0.9s;
  }

  :global(.reveal-visible) .fd--draw .fd-notes,
  :global(.reveal-visible) .fd--draw .fd-labels {
    opacity: 1;
    transition: opacity 0.8s ease 1.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fd--draw .fd-lines path {
      stroke: rgb(var(--text) / 0);
      stroke-dashoffset: 0;
    }
    .fd--draw .fd-object,
    .fd--draw .fd-notes,
    .fd--draw .fd-labels {
      opacity: 1;
    }
    :global(.reveal-visible) .fd--draw .fd-lines path,
    :global(.reveal-visible) .fd--draw .fd-object,
    :global(.reveal-visible) .fd--draw .fd-notes,
    :global(.reveal-visible) .fd--draw .fd-labels {
      transition: none;
