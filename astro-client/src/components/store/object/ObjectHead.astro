---
/**
 * Head tags for pages that show VOJMAX objects. Use as
 * <ObjectHead slot="head" /> inside BaseLayout.
 *
 * Loads the world's technical mono and opts the store pages into
 * cross-document view transitions, so moving between the store, a category
 * and an object crossfades, and the object's artwork carries across when it
 * appears on both pages (it shares a view-transition-name). Browsers without
 * support simply navigate.
 */
interface Props {
  /** Keep a page out of search results, e.g. the cover export page. */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;
---

{noindex && <meta name="robots" content="noindex, nofollow" />}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
/>

<style is:global>
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.35s;
  }

  ::view-transition-group(*) {
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
