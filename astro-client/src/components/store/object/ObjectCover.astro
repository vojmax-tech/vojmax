---
/**
 * Cover artwork for a VOJMAX object. One composition, four crops:
 *
 *   card      store catalogue card: the object and two corner labels
 *   stage     product page hero: adds the annotation layer
 *   poster    16:10 campaign cover (social, docs, category card image)
 *   portrait  4:5 campaign cover for feeds
 *
 * The artwork is a concept visualisation of the object, and the stage says
 * so. Everything is sized in container units, so the same markup holds from a
 * 320px card to the 1600px export. Posters are exported to PNG from
 * /store/covers/<slug> (see README).
 */
import { drawings } from "./drawings";
import VxMark from "./VxMark.astro";
import { formatPrice, productStatus } from "../../../data/products";
import type { Product } from "../../../data/products";

interface Props {
  product: Product;
  variant?: "card" | "stage" | "poster" | "portrait";
  /** Unique per page, passed on to the drawing's SVG ids. */
  id: string;
  /** Accessible description of the artwork. Omit when it is decorative. */
  label?: string;
}

const { product, variant = "card", id, label } = Astro.props;

// Each object brings its own drawing (see drawings.ts).
const Drawing = drawings[product.slug];

const isPoster = variant === "poster" || variant === "portrait";
const model = product.model ?? product.title;
---

<div class={`oc oc--${variant} vx-world`} data-object-cover>
  <div class="oc-glow" aria-hidden="true"></div>
  <div class="oc-grid" aria-hidden="true"></div>
  <span class="oc-crop oc-crop--tl" aria-hidden="true"></span>
  <span class="oc-crop oc-crop--tr" aria-hidden="true"></span>
  <span class="oc-crop oc-crop--bl" aria-hidden="true"></span>
  <span class="oc-crop oc-crop--br" aria-hidden="true"></span>

  {
    variant === "stage" ? (
      <div class="oc-top oc-top--stage" aria-hidden="true">
        <span>{product.artView ?? "Front view"}</span>
        <span>Concept visualisation<span class="oc-long">, not a photograph</span></span>
      </div>
    ) : (
      <div class="oc-top" aria-hidden="true">
        <span class="oc-brand font-display">
          <VxMark />
          {product.label ?? "VOJMAX"}
        </span>
        <span class="oc-model">
          {model}
          {/* Posters travel without the page around them, so they carry the caveat. */}
          {isPoster && <span class="oc-concept">Concept visualisation</span>}
        </span>
      </div>
    )
  }

  <div class="oc-art">
    {
      Drawing ? (
        <Drawing
          id={id}
          annotate={variant !== "card"}
          draw={variant === "stage"}
          label={label}
        />
      ) : (
        <span class="oc-fallback font-display" aria-hidden="true">{model}</span>
      )
    }
  </div>

  {
    isPoster && (
      <div class="oc-bottom oc-bottom--poster">
        <span class="oc-name font-display">{product.title}</span>
        <span class="oc-meta">
          <span class="oc-status">
            <span class="oc-dot" aria-hidden="true" />
            {productStatus(product)}
          </span>
          <span class="oc-price font-display">{formatPrice(product)}</span>
        </span>
      </div>
    )
  }
</div>

<style>
  .oc {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: size;
    background: rgb(var(--bg));
    isolation: isolate;
  }

  /* Soft studio light from above, a trace of orange low on the left. */
  .oc-glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(60% 58% at 50% 36%, rgb(118 138 196 / 0.16), transparent 70%),
      radial-gradient(38% 34% at 14% 92%, rgb(255 115 0 / 0.09), transparent 72%),
      linear-gradient(180deg, rgb(255 255 255 / 0.015), transparent 40%);
  }

  /* Minor grid every 4cqi, major every 16cqi, fading toward the edges.
     --gx/--gy are nudged by the page on pointer move (stage only). */
  .oc-grid {
    position: absolute;
    inset: -4cqi;
    z-index: -1;
    background-image:
      linear-gradient(rgb(var(--border) / 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--border) / 0.11) 1px, transparent 1px),
      linear-gradient(rgb(var(--border) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--border) / 0.05) 1px, transparent 1px);
    background-size:
      16cqi 16cqi,
      16cqi 16cqi,
      4cqi 4cqi,
      4cqi 4cqi;
    background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 70% 72% at 50% 44%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 72% at 50% 44%, #000 30%, transparent 100%);
    transform: translate3d(calc(var(--gx, 0) * 1px), calc(var(--gy, 0) * 1px), 0);
    transition:
      transform 0.9s var(--ease-out, ease),
      opacity 0.4s ease;
  }

  /* Crop marks, like a print artboard. */
  .oc-crop {
    --inset: max(10px, 2.6cqi);
    --len: max(8px, 1.5cqi);
    position: absolute;
    width: var(--len);
    height: var(--len);
    border: 0 solid rgb(var(--border) / 0.4);
  }

  .oc-crop--tl {
    top: var(--inset);
    left: var(--inset);
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .oc-crop--tr {
    top: var(--inset);
    right: var(--inset);
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .oc-crop--bl {
    bottom: var(--inset);
    left: var(--inset);
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .oc-crop--br {
    bottom: var(--inset);
    right: var(--inset);
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .oc-top,
  .oc-bottom {
    position: absolute;
    left: max(18px, 5cqi);
    right: max(18px, 5cqi);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .oc-top {
    top: max(16px, 4.6cqi);
  }

  .oc-bottom {
    bottom: max(16px, 4.2cqi);
  }

  .oc-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: clamp(0.62rem, 1.5cqi, 1.9rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgb(var(--text));
  }

  .oc-model,
  .oc-top--stage {
    font-family: var(--font-tech);
    font-size: clamp(0.58rem, 1.15cqi, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--muted));
  }

  .oc-top--stage {
    font-size: clamp(0.58rem, 0.85cqi, 0.72rem);
  }

  .oc-model {
    text-align: right;
  }

  .oc-concept {
    display: block;
    margin-top: 0.9em;
    font-size: 0.62em;
    text-align: right;
    color: rgb(var(--faint));
  }

  @container (max-width: 1000px) {
    .oc-long {
      display: none;
    }
  }

  .oc-top--stage > span:last-child {
    color: rgb(var(--faint));
  }

  /* --art-top places the object's centre; --lift nudges it (card hover). */
  .oc-art {
    position: absolute;
    left: 50%;
    top: var(--art-top, 50%);
    width: var(--art-w, 80%);
    transform: translate(-50%, calc(-50% + var(--lift, 0px)));
    transition: transform 0.7s var(--ease-out, ease);
  }

  .oc-fallback {
    display: block;
    text-align: center;
    font-size: 12cqi;
    color: rgb(var(--text) / 0.9);
  }

  /* Crops. The drawing is 10:7, so width in cqh caps its height. */
  /* No annotations here, so the drawing's empty margins may run past the
     edge and the object itself fills the frame. */
  .oc--card {
    --art-w: min(128%, 148cqh);
    --art-top: 53%;
  }

  .oc--stage {
    --art-w: min(92%, 136cqh);
    --art-top: 53%;
  }

  .oc--poster {
    --art-w: 60%;
    --art-top: 41%;
  }

  .oc--portrait {
    --art-w: 94%;
    --art-top: 36%;
  }

  /* Posters: the name set large, status and price on the right. */
  .oc-bottom--poster {
    align-items: flex-end;
  }

  .oc-name {
    font-size: 11cqi;
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: rgb(var(--text));
  }

  .oc--portrait .oc-bottom--poster {
    flex-direction: column;
    align-items: flex-start;
    gap: 5cqi;
  }

  .oc--portrait .oc-name {
    font-size: 19.5cqi;
  }

  .oc-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.6cqi;
    padding-bottom: 0.6cqi;
  }

  .oc--portrait .oc-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .oc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.8em;
    padding: 0.7em 1.1em;
    border: 1px solid rgb(var(--border) / 0.22);
    border-radius: 999px;
    font-family: var(--font-tech);
    font-size: 1.15cqi;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--text) / 0.86);
  }

  .oc--portrait .oc-status {
    font-size: 2cqi;
  }

  .oc-dot {
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: rgb(var(--accent));
    box-shadow: 0 0 0 0.35em rgb(var(--accent) / 0.18);
  }

  .oc-price {
    font-size: 3.4cqi;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(var(--text));
  }

  .oc--portrait .oc-price {
    font-size: 5.4cqi;
  }

  .oc--poster .oc-brand,
  .oc--portrait .oc-brand {
    font-size: 1.7cqi;
  }

  .oc--portrait .oc-brand {
    font-size: 2.6cqi;
  }

  .oc--portrait .oc-model {
    font-size: 1.9cqi;
  }

  @media (prefers-reduced-motion: reduce) {
    .oc-grid,
    .oc-art {
      transition: none;
    }
  }
</style>
