---
/**
 * Object gallery. Slots come from `product.gallery` in order; the layout is
 * fixed by position (01 large, 02 and 03 stacked beside it, 04 and 05 below),
 * so adding `src` and `alt` to a slot swaps its placeholder for the photo
 * without touching this file.
 *
 * Placeholders are line drawings, captioned "Photograph to come", so nothing
 * here passes for photography of a sample that does not exist yet.
 */
import ObjectCover from "./ObjectCover.astro";
import { drawings, crops } from "./drawings";
import type { GallerySlot, Product } from "../../../data/products";

interface Props {
  product: Product;
  slots: GallerySlot[];
}

const { product, slots } = Astro.props;

const Drawing = drawings[product.slug];
const crop = crops[product.slug] ?? {};
// The side and environment drawings are of a wall object.
const wallObject = product.category === "frames";
---

<ol class="og" role="list">
  {
    slots.map((slot, i) => {
      const number = String(i + 1).padStart(2, "0");
      const cropBox = crop[slot.view];
      return (
        <li class={`og-slot og-slot--${i + 1}`}>
          <figure class="og-figure">
            <div class="og-media">
              {slot.src ? (
                <img src={slot.src} alt={slot.alt ?? ""} loading="lazy" decoding="async" />
              ) : slot.view === "cover" ? (
                <ObjectCover product={product} variant="card" id={`gallery-${i + 1}`} />
              ) : (
                <div class={`og-placeholder og-placeholder--${slot.view}`} aria-hidden="true">
                  <span class="og-crop og-crop--tl" />
                  <span class="og-crop og-crop--br" />
                  <div class="og-drawing">
                    {cropBox && Drawing ? (
                      <Drawing id={`gallery-${i + 1}`} mode="outline" viewBox={cropBox} />
                    ) : wallObject && slot.view === "side" ? (
                      // Profile against the wall: the body, the stepped face, and a
                      // depth mark with no figure.
                      <svg class="og-line" viewBox="120 40 360 620" fill="none">
                        <path class="og-wall" d="M250 50V650" />
                        <rect x="250" y="100" width="26" height="470" rx="4" />
                        <path d="M272 124V546" />
                        <path class="og-soft" d="M246 120L232 140M246 180L232 200M246 240L232 260M246 300L232 320M246 360L232 380M246 420L232 440M246 480L232 500M246 540L232 560" />
                        <path class="og-accent" d="M250 604V620M276 604V620M250 612H276" />
                      </svg>
                    ) : wallObject && slot.view === "environment" ? (
                      // Elevation of a wall: floor line, eye level, the object hung on it.
                      <svg class="og-line" viewBox="0 0 1000 600" fill="none">
                        <path d="M40 500H960" />
                        <path class="og-soft" d="M40 488H960" />
                        <path class="og-soft" d="M40 240H960" stroke-dasharray="3 7" />
                        <rect x="400" y="170" width="200" height="142" rx="8" />
                        <rect x="408" y="178" width="184" height="126" rx="4" />
                        <rect class="og-accent" x="452" y="198" width="96" height="84" />
                        <path class="og-soft" d="M500 330V470" stroke-dasharray="3 7" />
                      </svg>
                    ) : (
                      <svg class="og-cross" viewBox="0 0 40 40" fill="none">
                        <path d="M20 4V36M4 20H36" />
                        <circle cx="20" cy="20" r="9" />
                      </svg>
                    )}
                  </div>
                </div>
              )}
            </div>
            <figcaption class="og-caption vx-tech">
              <span class="og-num">{number}</span>
              <span class="og-label">{slot.label}</span>
              {!slot.src && (
                <span class="og-pending">{slot.view === "cover" ? "Concept visualisation" : "Photograph to come"}</span>
              )}
            </figcaption>
          </figure>
        </li>
      );
    })
  }
</ol>

<style>
  .og {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(11rem, 17vw, 15.5rem);
    gap: clamp(0.75rem, 1.4vw, 1.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .og-slot {
    min-width: 0;
  }

  .og-slot--1 {
    grid-column: 1 / 9;
    grid-row: span 2;
  }

  .og-slot--2,
  .og-slot--3 {
    grid-column: 9 / 13;
  }

  .og-slot--4 {
    grid-column: 1 / 6;
  }

  .og-slot--5 {
    grid-column: 6 / 13;
  }

  /* Slots past five fall into pairs. */
  .og-slot:nth-child(n + 6) {
    grid-column: span 6;
  }

  .og-figure {
    position: relative;
    height: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgb(var(--border) / 0.13);
    background: rgb(var(--panel2));
    transition: border-color 0.4s ease;
  }

  .og-figure:hover {
    border-color: rgb(var(--border) / 0.3);
  }

  .og-media {
    position: absolute;
    inset: 0;
  }

  .og-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .og-figure:hover .og-media img {
    transform: scale(1.03);
  }

  .og-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-image:
      linear-gradient(rgb(var(--border) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--border) / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center;
  }

  .og-crop {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid rgb(var(--border) / 0.35);
  }

  .og-crop--tl {
    top: 14px;
    left: 14px;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .og-crop--br {
    right: 14px;
    bottom: 14px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  .og-drawing {
    width: 72%;
    max-width: 30rem;
    opacity: 0.8;
    transition: opacity 0.5s ease;
  }

  /* Close crops fade out at the cut edges instead of stopping at a line. */
  .og-placeholder--detail .og-drawing {
    -webkit-mask-image: radial-gradient(closest-side, #000 75%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 75%, transparent 100%);
  }

  .og-placeholder--detail .og-drawing {
    width: min(62%, 15rem);
  }

  .og-placeholder--side .og-drawing {
    width: auto;
    height: 78%;
  }

  .og-placeholder--side .og-line {
    width: auto;
    height: 100%;
  }

  .og-placeholder--surface .og-drawing {
    width: min(58%, 19rem);
  }

  .og-placeholder--environment .og-drawing {
    width: 88%;
  }

  .og-figure:hover .og-drawing {
    opacity: 1;
  }

  .og-line,
  .og-cross {
    display: block;
    width: 100%;
    stroke: rgb(var(--muted) / 0.62);
    stroke-width: 1.1;
  }

  .og-line *,
  .og-cross * {
    vector-effect: non-scaling-stroke;
  }

  .og-line .og-soft,
  .og-line .og-wall {
    stroke: rgb(var(--border) / 0.28);
  }

  .og-line .og-accent {
    stroke: rgb(var(--accent) / 0.8);
  }

  .og-cross {
    width: 2.5rem;
    margin-inline: auto;
    stroke: rgb(var(--faint));
  }

  .og-caption {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.62rem;
    pointer-events: none;
  }

  .og-num {
    color: rgb(var(--accent));
  }

  .og-label {
    color: rgb(var(--text) / 0.9);
  }

  .og-pending {
    margin-left: auto;
    color: rgb(var(--muted));
  }

  /* Covers carry their own corner labels at the top; keep the caption clear. */
  .og-slot--1 .og-caption {
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
  }

  @media (max-width: 900px) {
    .og {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .og-slot,
    .og-slot:nth-child(n + 6) {
      grid-column: span 1;
      grid-row: auto;
    }

    .og-slot .og-figure {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    .og-slot--1 {
      grid-column: 1 / -1;
    }

    .og-slot--1 .og-figure {
      aspect-ratio: 16 / 10;
    }

    .og-drawing {
      width: 84%;
    }

    .og-placeholder--detail .og-drawing,
    .og-placeholder--surface .og-drawing {
      width: 72%;
    }
  }

  @media (max-width: 520px) {
    .og-slot--1 .og-figure {
      aspect-ratio: 4 / 3;
    }

    .og-pending {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .og-media img,
    .og-drawing {
      transition: none;
    }
    .og-figure:hover .og-media img {
      transform: none;
    }
  }
</style>
